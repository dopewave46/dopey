# DopeOrca OS — backend environment
# Copy to `.env` and fill in. `.env` is git-ignored. Never commit real secrets.

# --- server ---
NODE_ENV=development           # development | production | test
PORT=4000                     # API port
LOG_LEVEL=info                 # trace | debug | info | warn | error

# --- auth ---
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string
SESSION_TTL_HOURS=168         # session lifetime (7 days); sliding-renewed on each request

# One-time admin seed (used only when no admin exists — see `npm run seed` in Prompt 10).
ADMIN_EMAIL=hello@dopeorca.tech
ADMIN_PASSWORD=change-this-on-first-login
ADMIN_NAME=Shahid Khan

# --- CORS ---
# Origin the frontend is served from (Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# --- database (Prompt 10) ---
# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Local development: leave USE_EMBEDDED_PG=true and a local Postgres is started
# automatically against this URL (no install, no Docker) — data in server/.pgdata.
# Production: point this at a managed Postgres and set USE_EMBEDDED_PG=false.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dopeorca_os
USE_EMBEDDED_PG=true

# --- notifications engine ---
NOTIFICATIONS_INTERVAL_MINUTES=60   # how often the scheduled evaluation runs
RENEWAL_LEAD_DAYS=30                # AMC "expiring soon" / renewal-reminder window
DEADLINE_LEAD_DAYS=5               # project "deadline approaching" window
